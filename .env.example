# Obrigatórias
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-v4-flash-0731

# Slugs do OpenRouter em ordem, separados por vírgula
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.6-luna

# Endpoint e atribuição da aplicação
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Planejador de Editais
OPENROUTER_APP_URL=

# Privacidade: defaults seguros para documentos
OPENROUTER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny

# Gates de segurança: permanecem falsos até aprovação documentada do ambiente
OPENROUTER_DOCUMENT_TRANSFER_APPROVED=false
LOCAL_PDF_PARSING_APPROVED=false

# Resiliência e orçamento de saída
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_RETRIES=0
OPENROUTER_MAX_TOKENS=8192

# native, cloudflare-ai ou mistral-ocr
OPENROUTER_PDF_ENGINE=cloudflare-ai

# API de projetos
DATABASE_URL=postgresql://planejador:change-me@localhost:5432/planejador
DDL_DATABASE_URL=postgresql://planejador_ddl:change-me@localhost:5432/planejador
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGINS=http://127.0.0.1:4173
SECURITY_MODE=loopback-development
TRUSTED_PROXY_IPS=none

# Upload privado e processamento assíncrono de editais
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_DOCUMENT_BUCKET=planejador-editais
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://127.0.0.1:6379/0
DOCUMENT_QUEUE_NAME=document-processing

# OIDC padrão (compatível com ZITADEL, Keycloak e outros provedores conformes)
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=planejador-api
OIDC_CLIENT_ID=planejador-web
OIDC_CALLBACK_URL=http://127.0.0.1:3001/auth/callback
OIDC_SIGNING_ALGORITHM=ES256
OIDC_ACCESS_TOKEN_TYP=at+jwt
OIDC_ACCESS_TOKEN_DISCRIMINATOR_CLAIM=token_use
OIDC_ACCESS_TOKEN_DISCRIMINATOR_VALUE=access
